/*
Ranger 1 board.
 */

/dts-v1/;

#include <../boards/pjrc/teensy4/teensy41.dts>

#define ANALOG_SENSORS_ADC_RESOLUTION 12
#define ANALOG_SENSORS_ADC_OVERSAMPLING 0

/*
TODO:
- LoRa radio
- External ADCs
- GPIO expanders
- TVC CANBUS
*/

/ {
    model = "Ranger 1";

    aliases {
        // VN-300 IMU
        imu-uart = &lpuart6; // TX: Pin 1 (AD_B0_02), RX: Pin 0 (AD_B0_03)

        // TF02-Pro LiDARs
        lidar-1-uart = &lpuart7; // TX: Pin 29 (EMC_31), RX: Pin 28 (EMC_32)
        lidar-2-uart = &lpuart8; // TX: Pin 20 (AD_B1_10), RX: Pin 21 (AD_B1_11)

        // JAVAD TR-2S GNSS
        gnss-uart = &lpuart3; // TX: Pin 14, RX: Pin 13

        // RFM95W LoRa tranceiver
        lora-tranceiver = &sx1276;

        // Throttle motor driver hardware timers, controls PUL/DIR signals.
        fuel-valve-stepper-pulse-counter = &pit0_channel0;
        lox-valve-stepper-pulse-counter = &pit0_channel1;
    };

    zephyr,user {
        // Throttle motor drivers
        fuel-valve-stepper-pul-gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>; // Pin 11
        fuel-valve-stepper-dir-gpios = <&gpio2 1 GPIO_ACTIVE_HIGH>; // Pin 12
        fuel-valve-stepper-ena-gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>; // Pin 10
        fuel-valve-encoder-a-gpios = <&gpio4 8 GPIO_ACTIVE_HIGH>; // Pin 5
        fuel-valve-encoder-b-gpios = <&gpio4 6 GPIO_ACTIVE_HIGH>; // Pin 4

        lox-valve-stepper-pul-gpios = <&gpio2 16 GPIO_ACTIVE_HIGH>; // Pin 8
        lox-valve-stepper-dir-gpios = <&gpio2 11 GPIO_ACTIVE_HIGH>; // Pin 9
        lox-valve-stepper-ena-gpios = <&gpio2 17 GPIO_ACTIVE_HIGH>; // Pin 7
        lox-valve-encoder-a-gpios = <&gpio4 4 GPIO_ACTIVE_HIGH>; // Pin 2
        lox-valve-encoder-b-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>; // Pin 1

        // ADC channels used by AnalogSensors.
        // U7 (AIN0–15) + U8 (AIN16–31) via ADS7953 on lpspi3.
        analog-sensor-max-adc-channels = <17>; // 16 channels + 1 sentinel slot
        io-channels =
            <&ads7953_1 0>,  <&ads7953_1 1>,  <&ads7953_1 2>,  <&ads7953_1 3>,
            <&ads7953_1 4>,  <&ads7953_1 5>,  <&ads7953_1 6>,  <&ads7953_1 7>,
            <&ads7953_1 8>,  <&ads7953_1 9>,  <&ads7953_1 10>, <&ads7953_1 11>,
            <&ads7953_1 12>, <&ads7953_1 13>, <&ads7953_1 14>, <&ads7953_1 15>,
            <&ads7953_2 0>,  <&ads7953_2 1>,  <&ads7953_2 2>,  <&ads7953_2 3>,
            <&ads7953_2 4>,  <&ads7953_2 5>,  <&ads7953_2 6>,  <&ads7953_2 7>,
            <&ads7953_2 8>,  <&ads7953_2 9>,  <&ads7953_2 10>, <&ads7953_2 11>,
            <&ads7953_2 12>, <&ads7953_2 13>, <&ads7953_2 14>, <&ads7953_2 15>;
        analog-sensor-adcs = <&ads7953_1 &ads7953_2>;
        analog-sensor-adc-oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
        analog-sensor-adc-resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;

        // GPIOs connected to valves. Valve channel numbers are indexed by their position in this list.
        valve-gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>, <&gpio2 17 GPIO_ACTIVE_HIGH>, <&gpio2 16 GPIO_ACTIVE_HIGH>;
    };

    chosen {
        zephyr,console = &cdc_acm_uart0;
    };
};

// VN-300 IMU
&lpuart1 {
    status = "okay";
    current-speed = <115200>;
};

// TF-02 Pro LiDARs
&lpuart2 {
    status = "okay";
    current-speed = <115200>;
};

&lpuart8 {
    status = "okay";
    current-speed = <115200>;
};

// JAVAD TR-2S GNSS
&lpuart3 {
    status = "okay";
    current-speed = <115200>; // Is this right?
};

// TODO: RFM95W RF CHIP, validate this? Duped on hornet/vehicle boards.
&lpspi4 {
    status = "okay";

    // TODO: Are the miso/mosi correct? this driver has a mio/sdo and I'm pretty sure there's an option to set which is miso/mosi.

    // Hardware CS0: Pin 10
    // MOSI: Pin 11
    // MISO: Pin 12
    // SCK: Pin 13

    // Is this right?
    // RFM95W: https: //www.adafruit.com/product/3072
    sx1276: sx1276@0 {
        compatible = "semtech,sx1276";
        reg = <0x0>;
        reset-gpios = <&gpio4 4 GPIO_ACTIVE_HIGH>; // Pin 4
        dio-gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>; // Pin 6
        spi-max-frequency = <DT_FREQ_M(67)>; // THIS IS 100% WRONG!!!! FIX ME!!!!!
    };
};

// Docs: https: //docs.zephyrproject.org/latest/build/dts/api/bindings/pinctrl/nxp%2Cmcux-rt-pinctrl.html
&pinctrl {
    // Software CS GPIO pins for ADS7953.
    // These pads can also mux as LPSPI4_PCS2/PCS1, but the ADC data bus is on LPSPI3,
    // so drive them as GPIO chip-selects.
    // Pin 36 = GPIO_B1_02 = gpio2_io18 = LPSPI4_PCS2 (U8 CS)
    // Pin 37 = GPIO_B1_03 = gpio2_io19 = LPSPI4_PCS1 (U7 CS)
    pinmux_lpspi3_cs_gpios: pinmux_lpspi3_cs_gpios {
        group0 {
            pinmux = <&iomuxc_gpio_b1_02_gpio2_io18>,
                     <&iomuxc_gpio_b1_03_gpio2_io19>;
            drive-strength = "r0-6";
            slew-rate = "slow";
        };
    };

    pinmux_adc1: pinmux_adc1 {
        group0 {
            pinmux = <&iomuxc_gpio_ad_b1_04_gpio1_io20>,
                     <&iomuxc_gpio_ad_b1_05_gpio1_io21>,
                     <&iomuxc_gpio_ad_b1_03_gpio1_io19>,
                     <&iomuxc_gpio_ad_b1_07_gpio1_io23>,
                     <&iomuxc_gpio_ad_b1_06_gpio1_io22>,
                     <&iomuxc_gpio_ad_b1_00_gpio1_io16>,
                     <&iomuxc_gpio_ad_b1_01_gpio1_io17>,
                     <&iomuxc_gpio_ad_b1_10_gpio1_io26>;
            bias-disable; // These should be pulled down by voltage divider
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };

   // LPUART6: pins 0/1
    pinmux_lpuart6: pinmux_lpuart6 {
        group0 {
            pinmux = <&iomuxc_gpio_ad_b0_02_lpuart6_tx>,
                     <&iomuxc_gpio_ad_b0_03_lpuart6_rx>;
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };

    pinmux_lpuart6_sleep: pinmux_lpuart6_sleep {
        group0 {
            pinmux = <&iomuxc_gpio_ad_b0_02_lpuart6_tx>;
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };

    // LPUART7: pins 28/29
    pinmux_lpuart7: pinmux_lpuart7 {
        group0 {
            pinmux = <&iomuxc_gpio_emc_31_lpuart7_tx>,
                     <&iomuxc_gpio_emc_32_lpuart7_rx>;
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };

    pinmux_lpuart7_sleep: pinmux_lpuart7_sleep {
        group0 {
            pinmux = <&iomuxc_gpio_emc_31_lpuart7_tx>;
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };

    // LPUART8: pins 20/21
    pinmux_lpuart8: pinmux_lpuart8 {
        group0 {
            pinmux = <&iomuxc_gpio_ad_b1_10_lpuart8_tx>,
                     <&iomuxc_gpio_ad_b1_11_lpuart8_rx>;
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };

    pinmux_lpuart8_sleep: pinmux_lpuart8_sleep {
        group0 {
            pinmux = <&iomuxc_gpio_ad_b1_10_lpuart8_tx>;
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };

    // LPUART3: pins 16/17
    pinmux_lpuart3: pinmux_lpuart3 {
        group0 {
            pinmux = <&iomuxc_gpio_ad_b1_06_lpuart3_tx>,
                     <&iomuxc_gpio_ad_b1_07_lpuart3_rx>;
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };

    pinmux_lpuart3_sleep: pinmux_lpuart3_sleep {
        group0 {
            pinmux = <&iomuxc_gpio_ad_b1_06_lpuart3_tx>;
            drive-strength = "r0-6";
            slew-rate = "slow";
            nxp,speed = "100-mhz";
        };
    };
};

// VN-300 IMU (pins 0/1)
&lpuart6 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&pinmux_lpuart6>;
    pinctrl-1 = <&pinmux_lpuart6_sleep>;
    pinctrl-names = "default", "sleep";
};

// TF-02 Pro LiDAR #1 (pins 28/29)
&lpuart7 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&pinmux_lpuart7>;
    pinctrl-1 = <&pinmux_lpuart7_sleep>;
    pinctrl-names = "default", "sleep";
};

// TF-02 Pro LiDAR #2 (pins 20/21)
&lpuart8 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&pinmux_lpuart8>;
    pinctrl-1 = <&pinmux_lpuart8_sleep>;
    pinctrl-names = "default", "sleep";
};

// JAVAD TR-2S GNSS (pins 16/17)
&lpuart3 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&pinmux_lpuart3>;
    pinctrl-1 = <&pinmux_lpuart3_sleep>;
    pinctrl-names = "default", "sleep";
};


// Docs: https: //docs.zephyrproject.org/latest/build/dts/api/bindings/adc/nxp%2Cmcux-12b1msps-sar.
&adc1 {
    // She's broken, he's...
    status = "okay";
    pinctrl-0 = <&pinmux_adc1>;
    pinctrl-names = "default";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@5 {
        reg = <0x5>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;
        zephyr,oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
    };

    channel@6 {
        reg = <0x6>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;
        zephyr,oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
    };

    channel@8 {
        reg = <0x8>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;
        zephyr,oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
    };

    channel@9 {
        reg = <0x9>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;
        zephyr,oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
    };

    channel@a {
        reg = <0xa>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;
        zephyr,oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
    };

    channel@b {
        reg = <0xb>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;
        zephyr,oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
    };

    channel@c {
        reg = <0xc>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;
        zephyr,oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
    };

    channel@f {
        reg = <0xf>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>;
        zephyr,oversampling = <ANALOG_SENSORS_ADC_OVERSAMPLING>;
    };
};

// ADS7953 dual SPI ADC (U7 + U8)
// MOSI=pin26, MISO=pin39, SCK=pin27 → lpspi3 (pinmux defined upstream)
// CS: pin37=gpio2_19 (U7/AIN0-15), pin36=gpio2_18 (U8/AIN16-31)
&lpspi3 {
    status = "okay";
    pinctrl-0 = <&pinmux_lpspi3 &pinmux_lpspi3_cs_gpios>;
    pinctrl-names = "default";

    cs-gpios = <&gpio2 19 GPIO_ACTIVE_LOW>,   // Pin 37 → U7 (AIN0–15)
               <&gpio2 18 GPIO_ACTIVE_LOW>;   // Pin 36 → U8 (AIN16–31)

    ads7953_1: adc@0 {
        compatible = "ti,ads7953";
        reg = <0>;
        spi-max-frequency = <DT_FREQ_M(5)>;
        #io-channel-cells = <1>;
        ti,range = <2>;
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;

        channel@0  { reg = <0>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@1  { reg = <1>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@2  { reg = <2>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@3  { reg = <3>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@4  { reg = <4>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@5  { reg = <5>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@6  { reg = <6>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@7  { reg = <7>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@8  { reg = <8>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@9  { reg = <9>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@a  { reg = <10>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@b  { reg = <11>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@c  { reg = <12>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@d  { reg = <13>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@e  { reg = <14>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@f  { reg = <15>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
    };

    ads7953_2: adc@1 {
        compatible = "ti,ads7953";
        reg = <1>;
        spi-max-frequency = <DT_FREQ_M(5)>;
        #io-channel-cells = <1>;
        ti,range = <2>;
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;

        channel@0  { reg = <0>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@1  { reg = <1>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@2  { reg = <2>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@3  { reg = <3>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@4  { reg = <4>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@5  { reg = <5>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@6  { reg = <6>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@7  { reg = <7>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@8  { reg = <8>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@9  { reg = <9>;  zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@a  { reg = <10>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@b  { reg = <11>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@c  { reg = <12>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@d  { reg = <13>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@e  { reg = <14>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
        channel@f  { reg = <15>; zephyr,gain = "ADC_GAIN_1"; zephyr,reference = "ADC_REF_VDD_1"; zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; zephyr,resolution = <ANALOG_SENSORS_ADC_RESOLUTION>; };
    };
};

// MCP23017 U6 — I²C GPIO expander, GPIO_17–GPIO_32
// SCL=pin19 (AD_B1_00), SDA=pin18 (AD_B1_01) → lpi2c1
&lpi2c1 {
    pinctrl-0 = <&pinmux_lpi2c1>;
    pinctrl-names = "default";
    clock-frequency = <100000>;
    status = "okay";

    mcp23017_u6: gpio@20 {
        compatible = "microchip,mcp23017";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        status = "okay";
    };
};

// MCP23017 U4 — I²C GPIO expander, GPIO_1–GPIO_16
// SCL=pin16 (AD_B1_07), SDA=pin17 (AD_B1_06) → lpi2c3
&lpi2c3 {
    pinctrl-0 = <&pinmux_lpi2c3>;
    pinctrl-names = "default";
    clock-frequency = <100000>;
    status = "okay";

    mcp23017_u4: gpio@20 {
        compatible = "microchip,mcp23017";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        status = "okay";
    };
};

// Timer for stepper pulses.
// Docs: https: //docs.zephyrproject.org/latest/build/dts/api/bindings/counter/nxp%2Cpit.html
// Teensyduino equivalent: https: //sourcegraph.com/github.com/PaulStoffregen/cores/-/blob/teensy4/IntervalTimer.cpp
&pit0 {
    status = "okay";
};

&pit0_channel0 {
    status = "okay";
};

&pit0_channel1 {
    status = "okay";
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC_ACM_0";
    };
};

&enet_mac {
    /delete-property/ nxp,unique-mac;
    local-mac-address = [ 67 67 67 67 67 67  ];
};
